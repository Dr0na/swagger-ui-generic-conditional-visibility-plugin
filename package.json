{
  "name": "swagger-ui-generic-conditional-visibility-plugin",
  "version": "1.0.0",
  "description": "Generic Swagger UI plugin for x-conditional cascading parameters and request-body resolution",
  "license": "Apache-2.0",
  "main": "dist/generic-conditional-visibility-plugin.js",
  "files": [
    "dist",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf dist",
    "demo": "npm run build && npx --yes http-server . -p 9080 -c-1",
    "verify-demos": "node scripts/verify-demos.mjs",
    "pages:prepare": "npm run build && node scripts/prepare-pages.mjs",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs"
  },
  "keywords": [
    "swagger-ui",
    "openapi",
    "x-conditional",
    "x-visibility",
    "plugin",
    "conditional-visibility"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dr0na/swagger-ui-generic-conditional-visibility-plugin.git"
  },
  "devDependencies": {
    "playwright": "^1.49.1"
  }
}
